public class MoveZeroes {
    public static void moveZeroes(int[] nums) {

        int index = 0; // yahan next non-zero jayega

        // Step 1: non-zero elements ko aage lao
        for (int i = 0; i < nums.length; i++) {
            if (nums[i] != 0) {
                nums[index] = nums[i];
                index++;
            }
        }

        // Step 2: baaki jagah zero bhar do
        while (index < nums.length) {
            nums[index] = 0;
            index++;
        }
    }

    public static void main(String[] args) {
        int[] nums = {0, 1, 0, 3, 12};
        moveZeroes(nums);

        for (int n : nums) {
            System.out.print(n + " ");
        }
    }
}
