import java.util.*;

public class Main {
    public static void main(String[] args) {
      int[] arr = {10,20,30,40,50};
      int target = 60;
      int [] arr1  = new int [2];
      for(int i=0; i<arr.length-1;i++){
        for(int j=i+1;j<arr.length;j++){
          int sum = arr[i] + arr[j];
          if(sum == target){
            arr1[0]=i;
            arr1[1]=j;
          }
        }
      }
      for(int i=0;i<arr1.length;i++){
        System.out.print(arr1[i]+" ");
      }  
    }
}
