import java.util.HashMap;

public class TwoSum {

    public static void main(String[] args) {

        int[] arr = {2, 7, 11, 15};
        int target = 9;

        HashMap<Integer, Integer> map = new HashMap<>();

        for (int i = 0; i < arr.length; i++) {

            int needed = target - arr[i];

            // Check if required number already exists and print its index
            if (map.containsKey(needed)) {
                System.out.println("[" + map.get(needed) + ", " + i + "]");
                return;
            }
                              or 
                // Check if needed value already exists
                if (map.containsKey(needed)) {
 
                // Print values instead of indexes
                System.out.println("[" + needed + ", " + arr[i] + "]");
                return;
            }



            // Store number and its index
            map.put(arr[i], i);
        }
    }
}

