public class Main {
    public static void main(String[] args) {

        int[] arr = {10, 20, 5, 40, 50};

        int smallest = arr[0];   // assume first element is smallest

        for(int i = 1; i < arr.length; i++){
            if(arr[i] < smallest){
                smallest = arr[i];
            }
        }

        System.out.println("Smallest element is: " + smallest);
    }
}

