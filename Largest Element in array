public class Main {
    public static void main(String[] args) {

        int[] arr = {10, 20, 5, 40, 50};

        int largest = arr[0];   // assume first element is largest

        for(int i = 1; i < arr.length; i++){
            if(arr[i] > largest){
                largest = arr[i];
            }
        }

        System.out.println("Largest element is: " + largest);
    }
}
