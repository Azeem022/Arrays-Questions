public class MergeTwoArrays {
    public static void main(String[] args) {
        int [] arr1 = {1,2,3,4,5};
        int [] arr2 = {6,7,8,9,10};
        int n = arr1.length;
        int m = arr2.length;
        int i=0, j=0, k=0;
        int [] result = new int[n+m];
        
        while(i<n && j<m){
            if(arr1[i]<=arr2[j]){
                result[k++]=arr1[i++];
            }else{
                result[k++] = arr2[j++];
            }
        }
        
        while(i<n){
            result[k++] = arr1[i++];
        }
        
        while(j<m){
            result[k++] = arr2[j++];
        }
        System.out.print("Result is : " );
        for(int x:result){
            System.out.print(x+" " );
        }
}
}
